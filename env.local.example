# Copy this file to \".env.local\" and fill in the values
# NOTE: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser

# -----------------------------------------
# Backend integration
# -----------------------------------------
# REST API base URL (include the /api prefix exposed by backend)
# Example (local): http://localhost:9555/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:9555/api

# Socket.IO server URL for real-time updates
# Example (local): http://localhost:9555
NEXT_PUBLIC_WS_BACKEND_URL=http://localhost:9555

# -----------------------------------------
# Cookies (optional; for cross-domain deployments)
# -----------------------------------------
# Domain for cookies. Use your apex/root domain in production.
# Example: distahilar.vercel.app (or your custom domain)
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

# Use secure cookies only over HTTPS in production
# true | false
NEXT_PUBLIC_COOKIE_SECURE=false

# -----------------------------------------
# Notes
# -----------------------------------------
# - Keep NEXT_PUBLIC_* values consistent with the deployed backend
# - If backend is behind a proxy, ensure CORS and credentials are configured


